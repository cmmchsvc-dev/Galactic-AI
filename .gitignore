HEARTBEAT.md
AGENTS.md
TOOLS.md.bak

# ─── NEVER COMMIT — Credentials & sensitive config ───────────────────────────
# config.yaml IS tracked as a public TEMPLATE (placeholders only).
# ALL live values (keys, tokens, passwords, tuned settings) belong in the
# gitignored overlay config.local.yaml — runtime code only ever writes there.
config.local.yaml
config.local.yaml.*.tmp
.install_manifest.json
*.env
.env
*.key
*.token
*.secret
config/google_service_account.json
config/antigravity_token.json

# ─── NEVER COMMIT — Logs & runtime state ─────────────────────────────────────
logs/
*.jsonl
memory_*.json
checked_jobs.json
checked_posts.json
processed_emails.json
processed_emails.log
debug_core.log
*.db
*.sqlite
*.sqlite3

# ─── NEVER COMMIT — Vector stores ────────────────────────────────────────────
# These ingest VAULT.md / USER.md, so the raw personal text ends up in the
# SQLite FTS index in plaintext. `*.sqlite` does NOT match `.sqlite3` — that gap
# is how chroma_data/ got committed and pushed to a public repo for ~4 months.
chroma_data/
chroma_data.bak/

# ─── NEVER COMMIT — timestamped backups of secret-bearing files ──────────────
# config.local.yaml is ignored, but `config.local.yaml.bak-2026-07-26` is a
# DIFFERENT filename and the rule did not cover it. A `git add -A` swept one in
# on 2026-07-26 and GitHub push protection blocked the push — it carried live
# Google OAuth client id + secret. Cover every derivative of the overlay, and
# backup suffixes generally.
config.local.yaml*
*.bak
*.bak-*
*.bak2-*
*-backup-*
*.orig

# ─── TLS material generated for remote access ────────────────────────────────
certs/
*.pem

